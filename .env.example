# =============================================================================
# Clerk authentication — https://dashboard.clerk.com
# Copy this file to .env and fill in the publishable + secret keys.
# Both are required for the dev server / SSR runtime.
# =============================================================================

# Safe to ship to the browser. Starts with pk_test_… (dev) or pk_live_… (prod).
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace-me

# Server-only. Treat as a secret. Starts with sk_test_… (dev) or sk_live_… (prod).
CLERK_SECRET_KEY=sk_test_replace-me

# Optional: your Clerk Frontend API hostname (e.g. clerk.inkpxl.com). Used by
# the middleware to know which Clerk frontend to talk to. Falls back to deriving
# from the publishable key when not provided.
PUBLIC_CLERK_DOMAIN=
