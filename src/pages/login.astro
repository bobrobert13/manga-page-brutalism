---
export const prerender = false;
import AuthLayout from '@layouts/AuthLayout.astro';
import AuthCard from '@components/AuthCard.astro';
import AuthSidePanel from '@components/AuthSidePanel.astro';
import { SignIn } from '@clerk/astro/components';
import { clerkAppearance } from '@lib/clerk-appearance';

const title = 'Ingresar';
---

<AuthLayout {title} actionHref="/registro" actionLabel="Crear cuenta">
  <AuthSidePanel slot="side" variant="login" />
  <AuthSidePanel slot="mobile" variant="login" compact />

  <AuthCard>
    <span slot="stamp">AUTH · 2026</span>
    <span slot="heading">Bienvenido de vuelta</span>
    <span slot="kicker">/01 · login</span>

    <SignIn
      appearance={clerkAppearance}
      withSignUp={false}
      signUpUrl="/registro"
      fallbackRedirectUrl="/cuenta"
      oauthFlow="auto"
    />

    <div slot="footer" class="contents">
      <span>¿Sin cuenta? <a href="/registro">Creá una en /registro</a></span>
      <span>¿Olvidaste tu clave? <a href="/recuperar-clave">Recuperar por email</a></span>
    </div>
  </AuthCard>

  <span slot="disclaimer">Prototipo · Credenciales gestionadas de forma segura por Clerk</span>
</AuthLayout>
