---
export const prerender = false;
import AuthLayout from '@layouts/AuthLayout.astro';
import AuthCard from '@components/AuthCard.astro';
import AuthSidePanel from '@components/AuthSidePanel.astro';
import { SignUp } from '@clerk/astro/components';
import { clerkAppearance } from '@lib/clerk-appearance';
import { HTTP_CONFIG, ROUTES } from '@/config/index.config';

const title = 'Crear cuenta';
Astro.response.headers.set('Cache-Control', HTTP_CONFIG.cacheControl.private);
---

<AuthLayout {title} actionHref={ROUTES.login} actionLabel="Ingresar">
  <AuthSidePanel slot="side" variant="signup" />
  <AuthSidePanel slot="mobile" variant="signup" compact />

  <AuthCard stampRotation="left">
    <span slot="stamp">AUTH · 2026</span>
    <span slot="heading">Únete a INK/PXL</span>
    <span slot="kicker">/02 · signup</span>

    <SignUp
      appearance={clerkAppearance}
      signInUrl={ROUTES.login}
      fallbackRedirectUrl={ROUTES.account}
      oauthFlow="auto"
      unsafeMetadata={{ source: 'web' }}
    />

    <div slot="footer" class="contents">
      <span>¿Ya tenés cuenta? <a href={ROUTES.login}>Ingresá</a></span>
      <span>¿No te acordás de la clave? <a href={ROUTES.resetPassword}>Recuperar por email</a></span
      >
      <span class="mt-1 opacity-70"
        >Al crear la cuenta aceptás los <a href="#">Términos</a> y la <a href="#"
          >Política de Privacidad</a
        >.</span
      >
    </div>
  </AuthCard>

  <span slot="disclaimer">Prototipo · Cuenta gestionada de forma segura por Clerk</span>
</AuthLayout>
