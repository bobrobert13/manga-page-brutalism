---
/**
 * /detalle — permanent redirect to the new /titulo/[slug] route.
 */
import { ROUTES } from '@/config/index.config';

const slug = Astro.url.searchParams.get('slug');
const target = slug ? ROUTES.title(slug) : ROUTES.catalog;
Astro.response.status = 301;
Astro.response.headers.set('Location', target);
---
