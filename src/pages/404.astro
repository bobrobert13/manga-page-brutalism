---
export const prerender = true;

import BaseLayout from '@/layouts/BaseLayout.astro';
import Marquee from '@components/Marquee.astro';
import SiteHeader from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import { ROUTES } from '@/config/index.config';
---

<BaseLayout title="404 · Página no encontrada" noindex>
  <Marquee />
  <SiteHeader />

  <main
    id="main"
    class="px-6 md:px-12 py-20 md:py-32 grid-bg border-b-[3px] border-ink min-h-[60vh]"
  >
    <div class="max-w-3xl mx-auto text-center rise d1">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-red)] mb-4">
        Error 404
      </p>
      <h1 class="font-display text-[clamp(3.5rem,12vw,11rem)] tracking-tighter leading-[0.82]">
        Página<br />extraviada<span class="text-[var(--color-red)]">.</span>
      </h1>
      <p class="text-base md:text-lg leading-relaxed mt-6 max-w-xl mx-auto opacity-80">
        La historia que buscas se perdió en el infinito. Vuelve al inicio o explora el catálogo —
        hay 12,400+ esperando.
      </p>
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        <a
          href="/"
          class="cta-primary px-6 md:px-8 py-4 font-display text-lg md:text-xl flex items-center gap-3"
        >
          Volver al inicio <span aria-hidden="true">→</span>
        </a>
        <a
          href={ROUTES.catalog}
          class="brutal-border px-6 md:px-8 py-4 font-display text-lg md:text-xl bg-paper btn-invert"
        >
          Explorar catálogo
        </a>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
