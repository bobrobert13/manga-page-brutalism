---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Marquee from '@components/Marquee.astro';
import SiteHeader from '@components/SiteHeader.astro';
import SiteFooter from '@components/SiteFooter.astro';
import CatalogBrowser from '@components/CatalogBrowser.vue';
import { GENRES, MANGAS } from '@data/mangas';

// SSR-friendly: serialize data so the Vue island can hydrate without a re-fetch.
const initialMangas = [...MANGAS];
const genreList = [...GENRES];
---

<BaseLayout
  title="Catálogo"
  description="Explora las 12,400+ obras de INK/PXL: mangas japoneses, cómics americanos, webtoons y novelas ligeras. Filtros en vivo."
>
  <Marquee />
  <SiteHeader active="biblioteca" />

  <main id="main">
    <!-- ── Page header ── -->
    <section
      class="px-6 md:px-12 pt-10 md:pt-14 pb-0 grid-bg border-b-[3px] border-ink"
      aria-labelledby="catalog-h1"
    >
      <div class="rise d1">
        <div class="flex items-center gap-3 mb-4">
          <span class="font-mono text-[11px] uppercase tracking-[0.22em] opacity-70">
            — INK/PXL
          </span>
          <span class="w-6 h-px bg-ink" aria-hidden="true"></span>
          <span class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-red)]">
            12.4K títulos
          </span>
        </div>

        <h1 id="catalog-h1" class="font-display text-[clamp(2.8rem,8vw,7rem)] tracking-tighter">
          Catálogo
        </h1>

        <div
          class="flex flex-wrap items-center gap-2 mt-4 pb-6 text-sm md:text-base leading-snug max-w-2xl font-medium"
        >
          <span class="bg-ink text-paper px-2 py-0.5 -rotate-1 text-xs">Mangas</span>
          <span>japoneses ·</span>
          <span class="bg-yellow px-2 py-0.5 text-xs font-bold">Cómics</span>
          <span>americanos · Webtoons · Novelas ligeras</span>
        </div>
      </div>
    </section>

    <!-- ── Sticky filter bar (interactive island) ── -->
    <section class="sticky top-0 z-20 bg-paper border-b-[3px] border-ink" aria-label="Filtros">
      <div class="px-6 md:px-12 py-4">
        <CatalogBrowser client:visible initialMangas={initialMangas} genres={genreList} />
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
