---
interface Props {
  variant?: 'paper' | 'yellow';
  maxWidth?: 'md' | 'lg';
  stampRotation?: 'left' | 'right';
}

const { variant = 'paper', maxWidth = 'md', stampRotation = 'right' }: Props = Astro.props;
---

<section
  class:list={[
    'relative w-full bg-paper text-ink brutal-border brutal-shadow p-6 md:p-8',
    maxWidth === 'lg' ? 'max-w-lg' : 'max-w-md',
  ]}
  aria-labelledby="auth-card-heading"
>
  <span
    class:list={[
      'absolute -top-[14px] -right-[14px] z-10 brutal-border px-2.5 py-1.5 font-mono text-[9px] uppercase tracking-[0.22em]',
      variant === 'yellow' ? 'bg-yellow text-ink' : 'bg-ink text-paper',
      stampRotation === 'left' ? '-rotate-[4deg]' : 'rotate-[4deg]',
    ]}
    aria-hidden="true"
  >
    <slot name="stamp">AUTH · 2026</slot>
  </span>

  <header class="mb-5 flex items-baseline justify-between gap-3">
    <h1 id="auth-card-heading" class="font-display text-2xl md:text-3xl tracking-tighter">
      <slot name="heading">Ingresar</slot>
    </h1>
    <span class="font-mono text-[10px] uppercase tracking-[0.22em] opacity-70 shrink-0">
      <slot name="kicker">/01 · login</slot>
    </span>
  </header>

  <slot name="intro" />
  <slot />

  <footer
    class="mt-6 pt-4 border-t-[3px] border-[color:var(--color-ink-alpha-20)] font-mono text-[10px] uppercase tracking-[0.18em] flex flex-col gap-1.5"
  >
    <slot name="footer" />
  </footer>
</section>

<style>
  footer :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  footer :global(a:hover) {
    color: var(--color-red);
  }
</style>
