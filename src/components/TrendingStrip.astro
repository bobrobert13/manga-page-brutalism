---
/**
 * TrendingStrip — horizontal snap-scroll container for TrendingCard items.
 */
import TrendingCard from './TrendingCard.astro';
import type { Manga } from '@/types/manga';

interface Props {
  items: readonly Manga[];
  heading?: string;
  subtitle?: string;
  viewAllHref?: string;
}

const {
  items,
  heading = 'TRENDING NOW',
  subtitle = 'Más leídos esta semana',
  viewAllHref = '/catalogo',
} = Astro.props;
---

<section class="px-6 md:px-12 pt-8 pb-6" aria-labelledby="trending-heading">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-3">
      <h2 id="trending-heading" class="font-display text-xl md:text-2xl tracking-tighter">
        {heading}
      </h2>
      <span class="font-mono text-[10px] uppercase tracking-[0.2em] opacity-60 hidden md:inline">
        {subtitle}
      </span>
    </div>
    <a
      href={viewAllHref}
      class="font-mono text-[10px] uppercase tracking-[0.18em] transition-colors hover:text-[var(--color-red)]"
    >
      Ver todo <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="trend-scroll flex gap-4 overflow-x-auto pb-4 no-scrollbar">
    {items.map((manga) => <TrendingCard manga={manga} />)}
  </div>
</section>
