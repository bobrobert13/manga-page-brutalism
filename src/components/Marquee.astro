---
/**
 * Marquee — news ticker strip across the top of every page.
 * Content is duplicated twice for a seamless horizontal loop.
 */
import { MARQUEE_ITEMS } from '@/config/index.config';
---

<aside
  aria-label="Anuncios recientes"
  class="bg-ink text-paper border-b-[3px] border-ink overflow-hidden"
>
  <div class="marquee-track flex whitespace-nowrap">
    {
      [0, 1].map((copy) => (
        <div
          class="flex shrink-0 items-center gap-12 px-6 py-2 font-mono text-[11px] uppercase tracking-[0.22em]"
          aria-hidden={copy === 1 ? 'true' : undefined}
        >
          {MARQUEE_ITEMS.map((item) => (
            <span>{item}</span>
          ))}
        </div>
      ))
    }
  </div>
</aside>
