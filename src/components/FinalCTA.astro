---
/**
 * FinalCTA — dark banner with halftone texture and dual CTA.
 */
interface Props {
  heading?: string;
  subheading?: string;
  primaryHref?: string;
  secondaryHref?: string;
}

const {
  heading = '¿Listo para perderte en buenas historias?',
  subheading = '+12,400 mangas, cómics y webtoons esperan por ti. Gratis. Siempre.',
  primaryHref = '/catalogo',
  secondaryHref = '/catalogo',
} = Astro.props;
---

<section
  class="halftone bg-ink text-paper border-y-[3px] border-ink"
  aria-labelledby="final-cta-heading"
>
  <div class="px-6 md:px-12 py-14 md:py-20 text-center">
    <h2 id="final-cta-heading" class="font-display text-[clamp(2rem,6vw,5rem)] tracking-tighter">
      <Fragment set:html={heading} />
    </h2>
    <p
      class="font-mono text-xs md:text-sm uppercase tracking-[0.2em] opacity-70 mt-4 max-w-lg mx-auto"
    >
      {subheading}
    </p>

    <div class="flex flex-wrap justify-center gap-4 mt-8">
      <a href={primaryHref} class="cta-primary px-8 py-4 font-display text-lg md:text-xl">
        CREAR CUENTA GRATIS <span aria-hidden="true">→</span>
      </a>
      <a
        href={secondaryHref}
        class="brutal-border border-paper text-paper px-8 py-4 font-display text-lg md:text-xl transition-colors hover:bg-paper hover:text-ink"
      >
        EXPLORAR SIN CUENTA
      </a>
    </div>
  </div>
</section>
