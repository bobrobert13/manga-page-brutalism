---
/**
 * SiteHeader — top nav + logo + auth-aware actions.
 * When Clerk indicates the user is signed in, we replace the "Ingresar →" link
 * with the <UserButton /> popover. Otherwise we keep the old CTA.
 */
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { NAV } from '@/lib/site';
import { UserButton } from '@clerk/astro/components';
import { clerkAppearance } from '@lib/clerk-appearance';

interface Props {
  /** Highlight which top-level destination is active. */
  active?: 'biblioteca' | 'generos' | 'lanzamientos' | 'comunidad' | 'home';
  /** Make header sticky on scroll. */
  sticky?: boolean;
}

const { active = 'home', sticky = false } = Astro.props;

// Server-side: are we signed in? (undefined during static prerender)
const userId =
  typeof Astro.locals.auth === 'function' ? Astro.locals.auth().userId : null;

const headerClass = sticky
  ? 'sticky top-0 z-30 bg-paper border-b-[3px] border-ink'
  : 'relative z-30 bg-paper border-b-[3px] border-ink';
---

<header class:list={['px-6 md:px-12 py-5', headerClass]}>
  <div class="flex items-center justify-between gap-3">
    <Logo />

    <nav
      aria-label="Navegación principal"
      class="hidden lg:flex items-center gap-9 font-mono text-xs uppercase tracking-[0.18em]"
    >
      {
        NAV.map((item) => {
          const isActive =
            active ===
            item.label
              .toLowerCase()
              .normalize('NFD')
              .replace(/[\u0300-\u036f]/g, '');
          return (
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-2 transition-colors hover:text-[var(--color-red)]',
                isActive && 'text-[var(--color-red)]',
              ]}
            >
              <span class="text-[var(--color-red)]">{item.index}</span>
              <span>{item.label}</span>
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3">
      <button
        type="button"
        class="hidden md:inline-flex items-center gap-2 btn-invert px-4 py-2 font-mono text-xs uppercase tracking-[0.18em]"
      >
        <span>Buscar</span>
        <span aria-hidden="true">⌕</span>
      </button>

      <ThemeToggle />

      {
        userId ? (
          <UserButton appearance={clerkAppearance} signInUrl="/login" userProfileMode="modal" />
        ) : (
          <a
            href="/login"
            class="brutal-border brutal-shadow bg-ink text-paper px-4 py-2 font-mono text-xs uppercase tracking-[0.18em] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none"
          >
            Ingresar <span aria-hidden="true">→</span>
          </a>
        )
      }
    </div>
  </div>
</header>
