---
/**
 * SiteFooter — brand mark + legal links.
 */
import { SITE } from '@/lib/site';
---

<footer class="border-t-[3px] border-ink">
  <div
    class="px-6 md:px-12 py-5 flex flex-col md:flex-row items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.22em] opacity-70"
  >
    <div class="flex items-center gap-3">
      <span class="font-display text-sm tracking-tighter text-ink">{SITE.name}</span>
      <span aria-hidden="true">·</span>
      <span>&copy; 2026 {SITE.name}</span>
    </div>

    <nav aria-label="Enlaces legales" class="flex items-center gap-3">
      <a href="#" class="transition-colors hover:text-[var(--color-red)]">Términos</a>
      <span aria-hidden="true">·</span>
      <a href="#" class="transition-colors hover:text-[var(--color-red)]">Privacidad</a>
      <span aria-hidden="true">·</span>
      <a href="#" class="transition-colors hover:text-[var(--color-red)]">API</a>
      <span aria-hidden="true">·</span>
      <a href="#" class="transition-colors hover:text-[var(--color-red)]">v1.0.0</a>
    </nav>
  </div>
</footer>
