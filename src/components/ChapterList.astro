---
/**
 * ChapterList — bordered container that renders chapter rows.
 */
import ChapterRow from './ChapterRow.astro';
import type { Chapter } from '@/types/manga';

interface Props {
  chapters: readonly Chapter[];
  totalLabel?: string;
  readMoreHref?: string;
  slug?: string;
}

const { chapters, totalLabel, readMoreHref = '#', slug } = Astro.props;
---

<section aria-labelledby="chapters-heading">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-6">
    <div>
      <h2 id="chapters-heading" class="font-display text-2xl md:text-3xl tracking-tighter">
        CAPÍTULOS
      </h2>
      {
        totalLabel && (
          <p class="font-mono text-[11px] uppercase tracking-[0.2em] opacity-60 mt-1">
            {totalLabel}
          </p>
        )
      }
    </div>

    <div class="flex items-center gap-3">
      <div class="relative">
        <span
          class="absolute left-3 top-1/2 -translate-y-1/2 font-mono text-xs opacity-60"
          aria-hidden="true">⌕</span
        >
        <input
          type="search"
          placeholder="Buscar capítulo…"
          class="w-full md:w-56 brutal-border bg-paper px-8 py-2.5 font-mono text-xs uppercase tracking-[0.15em] outline-none focus:bg-ink focus:text-paper transition-colors placeholder:text-ink/40"
        />
      </div>
      <select
        class="brutal-border bg-paper px-3 py-2.5 font-mono text-xs uppercase tracking-[0.15em] outline-none"
      >
        <option>Más recientes</option>
        <option>Más antiguos</option>
      </select>
    </div>
  </div>

  <div class="brutal-border bg-paper divide-y divide-[color:var(--color-ink-alpha-10)]">
    {chapters.map((chapter) => <ChapterRow chapter={chapter} slug={slug} />)}
  </div>

  <a
    href={readMoreHref}
    class="brutal-border w-full py-4 mt-4 font-display text-base bg-paper btn-invert transition-colors flex items-center justify-center gap-3"
  >
    VER LOS {chapters.length}+ CAPÍTULOS <span aria-hidden="true">↓</span>
  </a>
</section>
