---
/**
 * Breadcrumb — accessible nav trail (Inicio / Catálogo / …).
 */
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: readonly Crumb[];
}

const { items } = Astro.props;
---

<nav
  aria-label="Ruta de navegación"
  class="px-6 md:px-12 py-3 border-b-[3px] border-ink font-mono text-[10px] uppercase tracking-[0.2em] opacity-70 bg-paper"
>
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((item, idx) => {
        const isLast = idx === items.length - 1;
        return (
          <li class="flex items-center gap-2">
            {item.href && !isLast ? (
              <a href={item.href} class="transition-colors hover:text-[var(--color-red)]">
                {item.label}
              </a>
            ) : (
              <span
                class:list={[isLast && 'opacity-40']}
                aria-current={isLast ? 'page' : undefined}
              >
                {item.label}
              </span>
            )}
            {!isLast && <span aria-hidden="true">/</span>}
          </li>
        );
      })
    }
  </ol>
</nav>
