---
import BaseLayout from './BaseLayout.astro';
import Logo from '@components/Logo.astro';
import SiteFooter from '@components/SiteFooter.astro';
import { ROUTES, SITE } from '@/config/index.config';

interface Props {
  title: string;
  description?: string;
  actionHref: string;
  actionLabel: string;
}

const { title, description = SITE.description, actionHref, actionLabel }: Props = Astro.props;

const { userId } = Astro.locals.auth();
if (userId) return Astro.redirect(ROUTES.home);
---

<BaseLayout {title} {description} noindex>
  <header
    class="px-5 sm:px-8 md:px-12 py-5 flex items-center justify-between border-b-[3px] border-ink bg-paper relative z-20"
  >
    <Logo />
    <div class="flex items-center gap-2 sm:gap-3">
      <a
        href={ROUTES.home}
        class="brutal-border px-3 py-2 font-mono text-[10px] sm:text-xs uppercase tracking-[0.18em] bg-paper hover:bg-ink hover:text-paper transition-colors hidden sm:inline-flex items-center gap-2"
      >
        <span aria-hidden="true">←</span> Volver
      </a>
      <a
        href={actionHref}
        class="brutal-border bg-ink text-paper px-3 sm:px-4 py-2 font-mono text-[10px] sm:text-xs uppercase tracking-[0.18em] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[4px_4px_0_0_var(--color-red)] transition-all"
      >
        {actionLabel} →
      </a>
    </div>
  </header>

  <main id="main" class="grid grid-cols-1 lg:grid-cols-12 min-h-[calc(100vh-77px)]">
    <slot name="side" />

    <section
      class="col-span-1 lg:col-span-7 grid-bg border-t-[3px] lg:border-t-0 border-ink flex items-start lg:items-center justify-center px-5 sm:px-8 md:px-12 py-10 lg:py-12"
    >
      <div class="w-full flex flex-col items-center">
        <slot name="mobile" />
        <slot />
        <p class="mt-4 text-center font-mono text-[10px] uppercase tracking-[0.22em] opacity-60">
          <slot name="disclaimer" />
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
