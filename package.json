{
  "name": "manga-brutalism-ui",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "INK/PXL — landing, catálogo y detalle para mangas y cómics. Brutalismo refinado construido con Astro + Vue + Tailwind 4.",
  "engines": {
    "node": ">=26.3.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:coverage": "vitest run --coverage",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/node": "^11.1.12",
    "@astrojs/vue": "^7.1.5",
    "@clerk/astro": "^4.1.23",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.1",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "astro": "^7.4.11",
    "axios": "^1.21.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "msw": "^3.0.5",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
